  m_Script: {fileID: 11500000, guid: 788bd1b0ae5be6d4997fcdc734a43244, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Clover.Runtime::Clover.World.SunCourtDirector
  boss: {fileID: 1246924247}
  player: {fileID: 21933569}
  hitStop: {fileID: 21933568}
  form: {fileID: 2036864187}
  bossHud: {fileID: 1787149226}
  coal: {fileID: 1221428962}
  wayOut: {fileID: 715772002}
  heatWall: {fileID: 1863142574}
  heatGlow: {fileID: 340711730}
  keyLight: {fileID: 585930307}
  shade: {fileID: 1142610453}
  standingSpear: {fileID: 1040325930}
  weaponBone: {fileID: 1180580817}
  ray: {fileID: 1580556986}
  rayLook: {fileID: 1580556984}
  spearTrail: {fileID: 1281519369}
  SpearFlight: 0.2
  LineZ: -20
  RisingDelay: 0.9
  RewardDelay: 1.2
  Embers: 5
  ManName: Khepharu,  God of Fire
  GodlyName: Khepharu,  the Sun-Bearer
  Speaker: Khepharu
  Greeting:
  - Another, sent with empty hands.
  - I know what sends you. It was here before the star fell.
  - I carried the day home on my back. They were sitting in the dark. Look at them now. Warm.
  - Come. It is noon.
  DyingWords:
  - The light is low.
  - I had forgotten evening.
  - Ask it what became of the morning.
  - Carry this better than I did.
  Barque:
  - You have it.
  - It burns the hand that holds it. You will learn where to hold it.
  - The sun is moving. That is your doing. Do not stay to watch it set.
  - The boat knows the way down the sky. Cast off.
  BarqueSpeaker: 
  HalfCallout: It is always noon.
  RisingCallout: The sun comes down
  RoarCallout: Khepharu, the Sun-Bearer
  FuryCallout: Noon breaks
  DuelDistance: 1.3
  DuelPitch: -8
