  m_Script: {fileID: 11500000, guid: 694925d99107355428ee965f7b9638b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Clover.Runtime::Clover.World.StoneCard
  ShowWithin: 1.1
  LineLength: 38
  Words: 'RAIN RING (Water, the ''bullets'' form)

    A ring of bullets appears round the enemy you face, hangs, then all fly inward together.

    Press use (E) to wear it. Hold Triangle (U) to cast. 30 mana.

    Mana comes back by itself while a stone''s spell is worn.'
  thing: {fileID: 2037475648}
  text: {fileID: 624405341}
  back: {fileID: 128867302}
  shown: {fileID: 1263218265}
  lineHeight: 0.17
  letterWidth: 0.075
