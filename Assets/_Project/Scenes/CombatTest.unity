  m_Script: {fileID: 11500000, guid: 694925d99107355428ee965f7b9638b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Clover.Runtime::Clover.World.StoneCard
  ShowWithin: 1.1
  LineLength: 38
  Words: 'SWORD OF DAY (Light, the ''sword'' form)

    One sword as tall as the screen falls where you aim. It leaves a crack in the ground that keeps biting.

    Press use (E) to wear it. Put it in a spell slot at a rest, then cast it with that slot ( + , , , ). 45 mana.

    Mana comes back by itself while a stone''s spell is worn.'
  thing: {fileID: 1255820998}
  text: {fileID: 1553159149}
  back: {fileID: 2129931185}
  shown: {fileID: 1858163870}
  lineHeight: 0.17
  letterWidth: 0.075
