  m_Script: {fileID: 11500000, guid: a0b73ad589799ca4c8e683dea5c26172, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Clover.Runtime::Clover.World.WakingNotice
  Prompt: Read
  Range: 2.3
  Speaker: A painted wall
  Lines:
  - Where the gold has flaked, the lamp-headed figure shows under it.
  - It was never seated. It is kneeling, and holding out a light.
  sleepers:
  - {fileID: 2075443599}
  - {fileID: 1394369793}
  Scare: Something behind you is warm.
