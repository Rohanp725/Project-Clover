  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38a132939015f5d4490b0716b1f00191, type: 3}
  m_Name: reaction_art
  m_EditorClassIdentifier: Clover.Runtime::Clover.Player.Forms.ReactionArtSet
  Looks:
  - Pair: 0
    Key: fire_lightning
    Name: Flashover
    Directed: 0
    FirstPart: 8
    PartCount: 8
    FirstLamp: 2
    LampCount: 2
    Triangles: 4896
    Pieces: 56
    ImpactAt: 0.18
    Seconds: 1.4000001
    Story: a bolt falls out of the sky, strobing; violet static crawls the limbs; the violet tongues climb in threes; violet embers and smoke rise as the char spreads
  - Pair: 2
    Key: wind_ice
    Name: Rime
    Directed: 1
    FirstPart: 48
    PartCount: 5
    FirstLamp: 11
    LampCount: 1
    Triangles: 3002
    Pieces: 85
    ImpactAt: 0.35
    Seconds: 1.4
    Story: wind streaks sweep in; rime grows on the near side; chips blow out of the far side and on down the wind; fog is carried after them and the feathers fan out
  - Pair: 6
    Key: earth_metal
    Name: Anvil Stone
    Directed: 0
    FirstPart: 96
    PartCount: 6
    FirstLamp: 18
    LampCount: 1
    Triangles: 3925
    Pieces: 27
    ImpactAt: 0.26
    Seconds: 1.3
    Story: the anvil springs up out of the ground under it and the ground heaves; the plates clang with a white-hot notch; shards and dust fly; the clang rings spread
  - Pair: 7
    Key: metal_light
    Name: Glint
    Directed: 0
    FirstPart: 118
    PartCount: 7
    FirstLamp: 22
    LampCount: 1
    Triangles: 743
    Pieces: 13
    ImpactAt: 0.16
    Seconds: 1.45
    Story: the slatted shaft strikes down; the plates clang and glint and sparks fork; the split beam runs to the next body; the jali print and shadow spread
  - Pair: 8
    Key: light_dark
    Name: Diamond Ring
    Directed: 0
    FirstPart: 33
    PartCount: 6
    FirstLamp: 8
    LampCount: 1
    Triangles: 416
    Pieces: 11
    ImpactAt: 0.38
    Seconds: 1.48
    Story: dark's streaks wheel in; the slatted shaft lands; the eclipse ring and its bead flare; the corona and shadow bands spread
  - Pair: 9
    Key: dark_poison
    Name: The Sealed Jar
    Directed: 0
    FirstPart: 73
    PartCount: 7
    FirstLamp: 16
    LampCount: 1
    Triangles: 6044
    Pieces: 98
    ImpactAt: 0.63
    Seconds: 2.4299998
    Story: the mites spiral in and the black mouth spreads; the lobed front laps and bursts; fumes hook inward
  - Pair: 10
    Key: poison_fire
