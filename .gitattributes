# Text files: normalised line endings in the repo, native on checkout
* text=auto
*.cs text diff=csharp
*.asmdef text
*.json text
*.md text
*.csv text
*.shader text
*.hlsl text
*.cginc text
*.compute text
*.uss text
*.uxml text
*.inputactions text
*.ps1 text

# Unity YAML: text, merged with UnityYAMLMerge (git config merge.unityyamlmerge.driver is set in this repo)
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
